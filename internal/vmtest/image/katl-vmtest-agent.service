[Unit]
Description=Katl vmtest guest agent
Documentation=man:systemd.service(5)
After=basic.target

[Service]
Type=simple
ExecStart=/usr/lib/katl/vmtest/katl-vmtest-agent
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
NoNewPrivileges=yes
# Observe and mutate the host mount namespace, including live extension refreshes.
# A private mount namespace retains stale /etc and /usr overlays.
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=katl-vmtest-agent

[Install]
WantedBy=multi-user.target
