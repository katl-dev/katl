#!/usr/bin/env bash
set -euo pipefail

virsh_bin="${KATL_VMTEST_VIRSH:-virsh}"
ps_bin="${KATL_VMTEST_PS:-ps}"
kill_bin="${KATL_VMTEST_KILL:-kill}"
sudo_bin="${KATL_VMTEST_SUDO:-sudo}"
repo_root="${KATL_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
go_bin="${KATL_VMTEST_GO:-go}"
release_bin="${KATL_VMTEST_RELEASE_NETWORKS:-}"
devclean_bin="${KATL_DEVCLEAN:-}"
podman_bin="${KATL_VMTEST_PODMAN:-podman}"

usage() {
    printf 'usage: scripts/vmtest-clean <run-dir|result.json>\n' >&2
}

# What may be deleted is decided by cmd/katl-devclean.
devclean() {
    if [[ -n "$devclean_bin" ]]; then
        "$devclean_bin" "$@"
    elif command -v katl-devclean >/dev/null 2>&1; then
        katl-devclean "$@"
    else
        (cd "$repo_root" && "$go_bin" run ./cmd/katl-devclean "$@")
    fi
}

if [[ "$#" -ne 1 ]]; then
    usage
    exit 2
fi

target="$1"
# Only a run directory is deleted. A single result.json names one node of a
# run, so its directory is left for the run as a whole to remove.
run_dir=""
if [[ -d "$target" ]]; then
    if ! info="$(devclean run-dir "$target")"; then
        printf 'vmtest-clean: not deleting %s\n' "$target" >&2
        exit 2
    fi
    run_dir="$(sed -n 's/^path=//p' <<<"$info")"
    mapfile -t result_files < <(find "$target" -name result.json -print | sort)
elif [[ -f "$target" ]]; then
    result_files=("$target")
elif info="$(devclean run-dir "$target" 2>/dev/null)" && grep -qx 'present=false' <<<"$info"; then
    printf 'vmtest-clean: %s is already removed\n' "$target" >&2
    exit 0
else
    printf 'vmtest-clean: target not found: %s\n' "$target" >&2
    exit 2
fi

if [[ "${#result_files[@]}" -eq 0 ]]; then
    printf 'vmtest-clean: no result.json files found under %s\n' "$target" >&2
    exit 2
fi

cleaned=0
recorded_domains=()
# Libvirt networks that the cleaned domains used, by libvirt URI.
declare -A recorded_networks=()
kill_qemu_pid() {
    local pid="$1"
    local domain="$2"

    if "$kill_bin" "$pid" >/dev/null 2>&1; then
        return 0
    fi
    if command -v "$sudo_bin" >/dev/null 2>&1 && "$sudo_bin" -n "$kill_bin" "$pid" >/dev/null 2>&1; then
        return 0
    fi
    printf 'vmtest-clean: failed to kill orphan qemu pid %s for %s\n' "$pid" "$domain" >&2
    return 1
}

cleanup_orphan_qemu() {
    local domain="$1"
    local killed=0
    local failed=0
    local pid args

    while read -r pid args; do
        if [[ -z "$pid" || -z "${args:-}" ]]; then
            continue
        fi
        if [[ "$args" == *qemu-system* && ( "$args" == *"guest=${domain},"* || "$args" == *"guest=${domain} "* ) ]]; then
            printf 'vmtest-clean: killing orphan qemu pid %s for %s\n' "$pid" "$domain" >&2
            kill_qemu_pid "$pid" "$domain" || failed=1
            killed=$((killed + 1))
        fi
    done < <("$ps_bin" -eo pid=,args=)

    if [[ "$failed" -ne 0 ]]; then
        return 1
    fi
    return 0
}

wait_domain_inactive() {
    local domain="$1"
    local uri="$2"
    local state

    for _ in {1..50}; do
        state="$("$virsh_bin" -c "$uri" domstate "$domain" 2>/dev/null || true)"
        case "$state" in
            ""|*"shut off"*|*"no state"*|*"not found"*)
                return 0
                ;;
        esac
        sleep 0.1
    done
    return 1
}

domain_exists() {
    local domain="$1"
    local uri="$2"

    "$virsh_bin" -c "$uri" dominfo "$domain" >/dev/null 2>&1
}

for result in "${result_files[@]}"; do
    while IFS=$'\t' read -r domain uri network; do
        if [[ -z "$domain" ]]; then
            printf 'vmtest-clean: refusing empty domain name in %s\n' "$result" >&2
            exit 2
        fi
        if [[ ! "$domain" =~ ^[A-Za-z0-9_.:-]+$ || "$domain" != katl-* ]]; then
            printf 'vmtest-clean: refusing unsafe domain name %q in %s\n' "$domain" "$result" >&2
            exit 2
        fi
        if [[ -z "$uri" ]]; then
            printf 'vmtest-clean: refusing empty libvirt URI for %s in %s\n' "$domain" "$result" >&2
            exit 2
        fi
        printf 'vmtest-clean: destroying %s on %s\n' "$domain" "$uri" >&2
        "$virsh_bin" -c "$uri" destroy "$domain" >/dev/null 2>&1 || {
            printf 'vmtest-clean: virsh destroy failed for %s; checking domain state\n' "$domain" >&2
        }
        if ! wait_domain_inactive "$domain" "$uri"; then
            printf 'vmtest-clean: %s is still active after destroy; checking for orphan qemu process\n' "$domain" >&2
            cleanup_orphan_qemu "$domain"
            if ! wait_domain_inactive "$domain" "$uri"; then
                printf 'vmtest-clean: failed to stop %s on %s\n' "$domain" "$uri" >&2
                exit 1
            fi
        fi
        printf 'vmtest-clean: undefining %s on %s\n' "$domain" "$uri" >&2
        "$virsh_bin" -c "$uri" undefine "$domain" --nvram >/dev/null 2>&1 || {
            printf 'vmtest-clean: virsh undefine failed for %s; checking for orphan qemu process\n' "$domain" >&2
            cleanup_orphan_qemu "$domain"
            if domain_exists "$domain" "$uri"; then
                printf 'vmtest-clean: failed to undefine %s on %s\n' "$domain" "$uri" >&2
                exit 1
            fi
        }
        cleaned=$((cleaned + 1))
        recorded_domains+=("$domain	$uri")
        # Worlds without a run network use libvirt's default one, which is not ours to remove.
        if [[ "$network" =~ ^[A-Za-z0-9_.:-]+$ && "$network" == katl-* ]]; then
            case " ${recorded_networks[$uri]:-} " in
                *" $network "*) ;;
                *) recorded_networks[$uri]="${recorded_networks[$uri]:-} $network" ;;
            esac
        fi
    done < <(
        jq -r '
          (.debug.targets // [])
          | map(select(.preserved == true))
          | .[]
          | [.domainName, .libvirtURI, (.network // "")]
          | @tsv
        ' "$result"
    )
done

if [[ "$cleaned" -eq 0 && -z "$run_dir" ]]; then
    printf 'vmtest-clean: no preserved vmtest domains recorded in %s\n' "$target" >&2
    exit 1
fi

# Release the networks only after every recorded domain is gone, so a network
# that two recorded domains shared is not kept for a domain removed later.
# Which networks a run owns, and whether anything still attaches to them, is
# decided by the same release that ends a scenario.
release_networks() {
    local uri="$1"
    shift

    if [[ -n "$release_bin" ]]; then
        "$release_bin" "$uri" "$@"
    elif command -v katl-vmtest-release-networks >/dev/null 2>&1; then
        katl-vmtest-release-networks "$uri" "$@"
    else
        (cd "$repo_root" && "$go_bin" run ./cmd/katl-vmtest-release-networks "$uri" "$@")
    fi
}

for uri in "${!recorded_networks[@]}"; do
    read -r -a names <<<"${recorded_networks[$uri]}"
    printf 'vmtest-clean: releasing libvirt network(s) %s on %s\n' "${names[*]}" "$uri" >&2
    release_networks "$uri" "${names[@]}" || exit 1
done

if [[ -z "$run_dir" ]]; then
    printf 'vmtest-clean: cleaned %d preserved domain(s)\n' "$cleaned" >&2
    exit 0
fi

# Deleting the run directory discards the only record of its domains, so
# confirm with libvirt that every one is gone first.
for entry in "${recorded_domains[@]}"; do
    IFS=$'\t' read -r domain uri <<<"$entry"
    if domain_exists "$domain" "$uri"; then
        printf 'vmtest-clean: %s still exists on %s; leaving %s in place\n' "$domain" "$uri" "$run_dir" >&2
        exit 1
    fi
done

# mkosi and libvirt leave read-only and relabelled files, and mkosi trees can be
# owned by subuids that only a user-namespace shell can change.
chmod -R u+rwX -- "$run_dir" 2>/dev/null || true
rm -rf -- "$run_dir" 2>/dev/null || true
if [[ -e "$run_dir" ]]; then
    # shellcheck disable=SC2016 # the script is expanded by the inner shell
    "$podman_bin" unshare sh -c 'chmod -R u+rwX -- "$1"; rm -rf -- "$1"' sh "$run_dir" || true
fi
if [[ -e "$run_dir" ]]; then
    printf 'vmtest-clean: failed to delete %s\n' "$run_dir" >&2
    exit 1
fi
printf 'vmtest-clean: cleaned %d preserved domain(s) and deleted %s\n' "$cleaned" "$run_dir" >&2
