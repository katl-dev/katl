#!/usr/bin/env bash
set -euo pipefail

repo_root="${KATL_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
go_bin="${KATL_WORKTREE_GO:-go}"
devclean_bin="${KATL_DEVCLEAN:-}"

if [[ "$#" -ne 1 ]]; then
    printf 'usage: scripts/worktree-clean <worktree-path>\n' >&2
    exit 2
fi
target="$1"

# cmd/katl-devclean decides whether the worktree may be removed, removes it
# (including build output owned by subuids), and reports what it could not.
devclean() {
    if [[ -n "$devclean_bin" ]]; then
        "$devclean_bin" "$@"
    elif command -v katl-devclean >/dev/null 2>&1; then
        katl-devclean "$@"
    else
        (cd "$repo_root" && "$go_bin" run ./cmd/katl-devclean "$@")
    fi
}

# katl-devclean exits 2 when it refused and removed nothing, and 1 when it
# removed some of the worktree and could not remove the rest.
rc=0
info="$(devclean remove worktree "$repo_root" "$target")" || rc=$?
case "$rc" in
    0) ;;
    1)
        printf 'worktree-clean: %s was only partly removed; fix what is listed above and run worktree-clean again\n' "$target" >&2
        exit 1
        ;;
    *)
        printf 'worktree-clean: %s was not removed\n' "$target" >&2
        exit "$rc"
        ;;
esac
git -C "$repo_root" worktree prune
path="$(sed -n 's/^path=//p' <<<"$info")"
branch="$(sed -n 's/^branch=//p' <<<"$info")"
delete_branch="$(sed -n 's/^delete-branch=//p' <<<"$info")"
keep_reason="$(sed -n 's/^keep-reason=//p' <<<"$info")"
merged_pr="$(sed -n 's/^merged-pr=//p' <<<"$info")"
tip="$(sed -n 's/^tip=//p' <<<"$info")"
if [[ -n "$merged_pr" && "$merged_pr" != 0 ]]; then
    printf 'worktree-clean: HEAD is the head of merged pull request #%s\n' "$merged_pr" >&2
fi

printf 'worktree-clean: removed %s\n' "$path" >&2

if [[ -z "$branch" ]]; then
    exit 0
fi
if [[ "$delete_branch" == true ]]; then
    # Deleted only if it still points at the commit that was judged safe.
    if git -C "$repo_root" update-ref -d "refs/heads/$branch" "$tip" >&2; then
        printf 'worktree-clean: deleted branch %s\n' "$branch" >&2
    else
        printf 'worktree-clean: kept branch %s: it moved after it was checked\n' "$branch" >&2
    fi
else
    printf 'worktree-clean: kept branch %s: %s\n' "$branch" "$keep_reason" >&2
fi
