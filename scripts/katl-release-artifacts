#!/usr/bin/env bash
set -euo pipefail

source_root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
repo_root="${KATL_REPO_ROOT:-$source_root}"
build_dir="${KATL_MKOSI_BUILD_DIR:-$repo_root/_build/mkosi}"
architecture="${KATL_ARCHITECTURE:-$(uname -m)}"
go_command="${KATL_RELEASE_GO:-go}"
production_baseline_file=scripts/production-upgrade-baseline.txt

fail() {
    echo "error: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: scripts/katl-release-artifacts version EVENT [MANUAL_VERSION]
       scripts/katl-release-artifacts upgrade-baseline
       scripts/katl-release-artifacts dev-version STABLE_TAG
       scripts/katl-release-artifacts notes VERSION
       scripts/katl-release-artifacts count-release-notes < MESSAGE
       scripts/katl-release-artifacts build-katlctl VERSION
       scripts/katl-release-artifacts verify-katlctl VERSION
       scripts/katl-release-artifacts stage VERSION OUTPUT_DIR
       scripts/katl-release-artifacts combine OUTPUT_DIR FLAVOUR=DIR...
EOF
    exit 2
}

# The version grammar belongs to internal/releaseversion. It is built from this
# script's own checkout, which KATL_REPO_ROOT may not be.
release_tool() {
    (cd "$source_root" && "$go_command" run ./cmd/katl-release "$@")
}

# Prints the final release tags among newline-separated tags, in their order.
stable_tags() {
    local -a tags
    mapfile -t tags <<<"$1"
    release_tool stable-tags "${tags[@]}"
}

# Reads the Release-Note trailers of the commit message MESSAGE. Squash
# commits can also carry notes in the prose before the trailer block. In note
# mode it prints the last reader note, or skip if every Release-Note asks to
# skip. In count mode it prints "<count> <multiline>": how many notes there
# are, skip included, and 1 when a body note continued onto a second line.
# BOUNDARY_ID must not occur in the message.
release_note_trailers() {
    local mode="$1" message="$2" boundary="Katl-Trailer-Boundary: $3"

    # Let Git locate and unfold the trailer block. Only notes in the preceding
    # body can continue on an unindented line.
    git interpret-trailers --no-divider --unfold --where=start --if-exists=add \
        --trailer "$boundary" <<<"$message" |
        awk -v boundary="$boundary" -v mode="$mode" '
            function flush() {
                if (!inside) return
                count++
                if (note == "skip") skipped = 1
                else { last = note; have_note = 1 }
                inside = 0
            }
            NR == 1 { next }
            $0 == boundary { flush(); in_trailers = 1; next }
            /^Release-Note:/ { flush(); note = $0; sub(/^Release-Note:[ \t]*/, "", note); inside = 1; next }
            !in_trailers && inside && NF { note = note " " $0; multiline = 1; next }
            { flush() }
            END {
                flush()
                if (mode == "count") print count + 0, multiline + 0
                else if (have_note) print last
                else if (skipped) print "skip"
            }
        '
}

commit_release_note() {
    release_note_trailers note "$(git show -s --format=%B "$1")" "$1"
}

# Counts the Release-Note trailers of the commit message on stdin.
count_release_notes() {
    local message
    message="$(cat)"
    release_note_trailers count "$message" "$(git hash-object --stdin <<<"$message")"
}

# Candidates and finals describe the same version's changes. Read the pin
# from the target commit so replay uses the original upgrade source.
release_notes_base() {
    local target="$1" final_tag="v${2%%-*}" tag tags releases
    local repository="${GITHUB_REPOSITORY:-}"
    local -a earlier_tags=()
    local -A published_tags=()
    if git cat-file -e "$target:$production_baseline_file" 2>/dev/null; then
        tag="$(production_upgrade_baseline "$target")" || return
        if stable_tag_precedes "$tag" "$final_tag"; then
            printf '%s\n' "$tag"
            return
        fi
    fi

    tags="$(git tag --list 'v[0-9]*' --sort=-version:refname)" || return
    tags="$(stable_tags "$tags")" || exit 1
    while IFS= read -r tag; do
        [[ -n "$tag" ]] && stable_tag_precedes "$tag" "$final_tag" || continue
        earlier_tags+=("$tag")
    done <<< "$tags"
    (("${#earlier_tags[@]}" > 0)) || return 0

    [[ -n "$repository" ]] || repository='{owner}/{repo}'
    releases="$(gh api --paginate "repos/$repository/releases?per_page=100" |
        jq -r '.[] | select(.draft == false and .prerelease == false) | .tag_name')" ||
        fail "cannot list published releases for $repository"
    releases="$(stable_tags "$releases")" || exit 1
    while IFS= read -r tag; do
        [[ -z "$tag" ]] || published_tags["$tag"]=1
    done <<< "$releases"

    for tag in "${earlier_tags[@]}"; do
        [[ -n "${published_tags[$tag]:-}" ]] || continue
        git rev-parse --verify --quiet "refs/tags/$tag^{commit}" >/dev/null ||
            fail "release tag does not point to a commit: $tag"
        printf '%s\n' "$tag"
        return
    done
    return 0
}

stable_tag_precedes() {
    printf '%s\n' "$1" "$2" | LC_ALL=C sort -V -C -u
}

# Prints the guidance file for a version: the published <version>.md, else the
# final release's <base>.md so a prerelease renders what its final release will,
# else the pending next.md. Prints nothing when none exists.
release_guidance_file() {
    local version="$1" candidate
    for candidate in "$version" "${version%%-*}" next; do
        if [[ -f "$repo_root/docs/releases/$candidate.md" ]]; then
            printf '%s\n' "$repo_root/docs/releases/$candidate.md"
            return 0
        fi
    done
}

generate_release_notes() {
    local version="$1"
    local current_tag="v$version"
    local repository_url="${KATL_RELEASE_REPOSITORY_URL:-https://github.com/katl-dev/katl}"
    local target previous_tag="" range commit hash subject short_hash area summary note release_notes
    local -a commits=()

    validate_version "$version"
    target="${KATL_RELEASE_TARGET:-HEAD}"
    git rev-parse --verify --quiet "$target^{commit}" >/dev/null ||
        fail "release notes target is not a commit: $target"

    previous_tag="$(release_notes_base "$target" "$version")" || return

    if [[ -n "$previous_tag" ]]; then
        range="refs/tags/$previous_tag..$target"
    else
        range="$target"
    fi

    mapfile -t commits < <(git log --format='%H%x09%s' "$range")
    printf '## Changes\n\n'
    if ((${#commits[@]} == 0)); then
        printf '_No commits were added since the previous KatlOS release._\n'
    fi
    local shown=0
    for commit in "${commits[@]}"; do
        IFS=$'\t' read -r hash subject <<<"$commit"
        [[ -n "$hash" ]] || continue
        note="$(commit_release_note "$hash")"
        [[ "$note" != skip ]] || continue
        short_hash="${hash:0:7}"
        if [[ -n "$note" ]]; then
            printf -- "- %s ([\`%s\`](%s/commit/%s))\n" \
                "$note" "$short_hash" "$repository_url" "$hash"
        elif [[ "$subject" =~ ^([^:]+):[[:space:]]+(.+)$ ]]; then
            area="${BASH_REMATCH[1]}"
            summary="${BASH_REMATCH[2]}"
            printf -- "- **%s:** %s ([\`%s\`](%s/commit/%s))\n" \
                "$area" "$summary" "$short_hash" "$repository_url" "$hash"
        else
            printf -- "- %s ([\`%s\`](%s/commit/%s))\n" \
                "$subject" "$short_hash" "$repository_url" "$hash"
        fi
        ((shown += 1))
    done
    if ((${#commits[@]} > 0 && shown == 0)); then
        printf '_No release note entries for this release._\n'
    fi

    release_notes="$(release_guidance_file "$version")"
    if [[ -n "$release_notes" ]]; then
        printf '\n'
        cat "$release_notes"
    fi

    printf '\n## Verify\n\n'
    printf 'Release assets have keyless GitHub build-provenance attestations. '
    printf 'See [PROVENANCE.md](%s/releases/download/%s/PROVENANCE.md) for verification instructions and scope.\n' \
        "$repository_url" "$current_tag"
    if [[ -n "$previous_tag" ]]; then
        printf "\n**Full comparison:** [\`%s...%s\`](%s/compare/%s...%s)\n" \
            "$previous_tag" "$current_tag" "$repository_url" "$previous_tag" "$current_tag"
    else
        printf '\nThis is the first KatlOS release in the repository history.\n'
    fi

    printf '\n## Support\n\n'
    if [[ "$version" == *-alpha.* ]]; then
        printf 'This is an experimental alpha release, not a production-supported release. '
    elif [[ "$version" == *-beta.* ]]; then
        printf 'This is an experimental beta release for home-lab evaluation, not a production-supported release. '
    fi
    printf 'Read [SUPPORT.md](%s/releases/download/%s/SUPPORT.md) before installation for the tested surface, trust and compatibility limits, recovery scope, and required issue evidence.\n\n' \
        "$repository_url" "$current_tag"
}

validate_version() {
    release_tool version "$1" || exit 1
}

verify_artifact() {
    local name="$1"
    local version="$2"
    local expected_architecture="${3:-$architecture}"
    local expected_flavour="${4:-${KATL_FLAVOUR:-standard}}"
    local expected_os="${5:-}"
    local digest size

    (cd "$build_dir" && sha256sum -c "$name.sha256")
    digest="$(sha256sum "$build_dir/$name" | awk '{print $1}')"
    size="$(stat -c %s "$build_dir/$name")"
    jq -e --arg digest "$digest" --argjson size "$size" \
        --arg version "$version" --arg architecture "$expected_architecture" \
        --arg os "$expected_os" \
        --arg flavour "$expected_flavour" \
        '.sha256 == $digest and .sizeBytes == $size and
         .version == $version and .architecture == $architecture and
         ($os == "" or .os == $os) and
         (.flavour // "standard") == $flavour' \
        "$build_dir/$name.json" >/dev/null ||
        fail "release metadata does not match artifact or release identity: $name.json"
}

build_katlctl() {
    local version="$1"
    local target goos goarch name path digest size build_commit build_date

    validate_version "$version"
    case "$architecture" in
        x86_64 | amd64) ;;
        *)
            fail "katlctl release architecture is unsupported: $architecture"
            ;;
    esac
    build_commit="${KATL_BUILD_COMMIT:-$(git -C "$repo_root" rev-parse HEAD)}"
    build_date="${KATL_BUILD_DATE:-1970-01-01T00:00:00Z}"
    mkdir -p "$build_dir"
    for target in linux:amd64 darwin:arm64; do
        IFS=: read -r goos goarch <<<"$target"
        name="katlctl-${version}-${goos}-${goarch}"
        path="$build_dir/$name"
        (
            cd "$repo_root"
            CGO_ENABLED=0 GOOS="$goos" GOARCH="$goarch" "$go_command" build \
                -trimpath \
                -ldflags="-s -w -X main.version=$version -X main.commit=$build_commit -X main.date=$build_date" \
                -o "$path" ./cmd/katlctl
        )
        digest="$(sha256sum "$path" | awk '{print $1}')"
        size="$(stat -c %s "$path")"
        printf '%s  %s\n' "$digest" "$name" >"$path.sha256"
        jq -n \
            --arg version "$version" \
            --arg commit "$build_commit" \
            --arg buildDate "$build_date" \
            --arg os "$goos" \
            --arg architecture "$goarch" \
            --arg sha256 "$digest" \
            --argjson sizeBytes "$size" \
            '{
                schemaVersion: 1,
                artifactKind: "katl.operator-cli.v1",
                name: "katlctl",
                version: $version,
                commit: $commit,
                buildDate: $buildDate,
                os: $os,
                architecture: $architecture,
                sha256: $sha256,
                sizeBytes: $sizeBytes
            }' >"$path.json"
        verify_artifact "$name" "$version" "$goarch" standard "$goos"
    done
}

# Every supported event supplies its version.
release_version() {
    local event="$1"
    local manual_version="${2:-}"
    local version

    case "$event" in
        workflow_dispatch|schedule|workflow_call)
            version="$manual_version"
            ;;
        *)
            fail "unsupported release event: $event"
            ;;
    esac

    if [[ "$version" == v[0-9]* ]]; then
        version="${version#v}"
    fi
    validate_version "$version"
    printf '%s\n' "$version"
}

# Succeeds for a final release tag, such as v2026.11.4, and fails for the
# development, alpha, beta and release-candidate tags.
is_stable_tag() {
    local stable
    stable="$(release_tool stable-tags "$1")" || exit 1
    [[ -n "$stable" ]]
}

production_upgrade_baseline() {
    local file="$production_baseline_file" revision="$1" tag
    if [[ -n "$revision" ]]; then
        tag="$(git show --end-of-options "$revision:$file")" || fail "cannot read $file at $revision"
    else
        tag="$(cat "$repo_root/$file")" || fail "cannot read $file"
    fi
    is_stable_tag "$tag" || fail "$file must contain a stable KatlOS release tag: $tag"
    git rev-parse --verify --quiet "refs/tags/$tag^{commit}" >/dev/null ||
        fail "$file names a tag that does not exist or does not point to a commit: $tag"
    printf '%s\n' "$tag"
}

# Prints the development version that sorts directly above a stable release, for
# builds that qualify production bytes without publishing them.
dev_version_above() {
    is_stable_tag "$1" || fail "not a stable KatlOS release tag: $1"
    local release="${1#v}"
    local version="${release%.*}.$((${release##*.} + 1))-dev.0"
    validate_version "$version"
    printf '%s\n' "$version"
}

write_checksums() {
    local dir="$1"
    (
        cd "$dir"
        mapfile -d '' checksum_files < <(
            find . -mindepth 1 -maxdepth 1 -type f \
                ! -name SHA256SUMS -printf '%f\0' | sort -z
        )
        ((${#checksum_files[@]} > 0)) || fail "release output has no files to checksum"
        sha256sum "${checksum_files[@]}" >SHA256SUMS
        sha256sum --check SHA256SUMS
    )
}

# Merges the assembled flavours into one publication directory. Files shared
# between flavours must be byte-identical; each flavour renders its own
# RELEASE_NOTES.md, so the first flavour's copy is kept.
combine_flavours() {
    local output="$1"
    shift
    [[ -z "$(ls -A "$output" 2>/dev/null)" ]] || fail "combine output is not empty: $output"
    mkdir -p "$output"
    local names=() spec name dir file
    for spec in "$@"; do
        [[ "$spec" == ?*=?* ]] || fail "expected FLAVOUR=DIR, got: $spec"
        name="${spec%%=*}"
        dir="${spec#*=}"
        [[ -d "$dir" ]] || fail "flavour directory is missing: $dir"
        names+=("$name")
        for file in "$dir"/*; do
            [[ -f "$file" && "${file##*/}" != SHA256SUMS ]] || continue
            if [[ ! -e "$output/${file##*/}" ]]; then
                cp -- "$file" "$output/"
            elif [[ "${file##*/}" != RELEASE_NOTES.md ]]; then
                cmp -s -- "$file" "$output/${file##*/}" ||
                    fail "${file##*/} differs between flavours (at $name)"
            fi
        done
    done
    (cd "$repo_root" && "$go_command" run ./cmd/katl-mkosi-artifacts release-components "$(realpath "$output")" "${names[@]}")
    write_checksums "$output"
}

stage_artifacts() {
    local version="$1"
    local output="$2"
    local name suffix path
    local -a checksum_files=()
    local -a names=(
        "katl-installer.efi"
        "katl-installer.vmlinuz"
        "katl-installer.initrd"
        "katl-installer.iso"
        "katlos-install-${version}-${architecture}.squashfs"
        "katlos-upgrade-${version}-${architecture}.squashfs"
    )
    local -a operator_names=(
        "katlctl-${version}-linux-amd64"
        "katlctl-${version}-darwin-arm64"
    )
    local build_inputs="katl-release-build-inputs.json"
    local -a package_inventories=(
        "katl-installer.packages.tsv"
        "katl-runtime.packages.tsv"
    )
    local extension_inventory="katl-runtime.extensions.json"

    validate_version "$version"
    [[ -n "$output" && "$output" != / && "$output" != . ]] ||
        fail "unsafe release output directory: $output"
    if [[ -e "$output" ]]; then
        [[ -d "$output" ]] || fail "release output is not a directory: $output"
        [[ -z "$(find "$output" -mindepth 1 -maxdepth 1 -print -quit)" ]] ||
            fail "release output directory is not empty: $output"
    fi

    for name in "${names[@]}"; do
        for suffix in "" .json .sha256; do
            path="$build_dir/$name$suffix"
            [[ -f "$path" ]] || fail "release artifact is missing: $path"
        done
        verify_artifact "$name" "$version"
    done
    for name in "${operator_names[@]}"; do
        for suffix in "" .json .sha256; do
            path="$build_dir/$name$suffix"
            [[ -f "$path" ]] || fail "release artifact is missing: $path"
        done
    done
    verify_artifact "${operator_names[0]}" "$version" amd64 standard linux
    verify_artifact "${operator_names[1]}" "$version" arm64 standard darwin
    names+=("${operator_names[@]}")
    for name in "${package_inventories[@]}"; do
        [[ -f "$build_dir/$name" ]] || fail "release package inventory is missing: $build_dir/$name"
    done
    [[ -f "$build_dir/$extension_inventory" ]] || fail "release extension inventory is missing: $build_dir/$extension_inventory"
    [[ -f "$build_dir/$build_inputs" ]] || fail "release build-input record is missing: $build_dir/$build_inputs"

    mkdir -p "$output"
    for name in "${names[@]}"; do
        for suffix in "" .json .sha256; do
            cp -- "$build_dir/$name$suffix" "$output/"
        done
    done
    for name in "${package_inventories[@]}"; do
        cp -- "$build_dir/$name" "$output/$name"
    done
    cp -- "$build_dir/$extension_inventory" "$output/$extension_inventory"
    cp -- "$build_dir/$build_inputs" "$output/$build_inputs"
    [[ -f "$repo_root/docs/support.md" ]] || fail "release support boundary is missing: $repo_root/docs/support.md"
    cp -- "$repo_root/docs/support.md" "$output/SUPPORT.md"
    cat >"$output/PROVENANCE.md" <<'EOF'
# KatlOS release provenance

Assets published from a KatlOS tag release are covered by keyless GitHub
build-provenance attestations issued to the `katl-dev/katl` release workflow.
Verify a downloaded asset with:

```sh
gh attestation verify <asset> \
  --repo katl-dev/katl \
  --signer-workflow katl-dev/katl/.github/workflows/release-artifacts.yml
```

`SHA256SUMS` and the adjacent `.sha256` files provide transport-integrity
checks. Provenance authenticates the repository and workflow that produced the
bytes; it does not assert that an artifact is vulnerability-free, provide a
Secure Boot signature, or replace Katl's future node-side trust policy.
EOF
    generate_release_notes "$version" >"$output/RELEASE_NOTES.md"
    (cd "$repo_root" && "$go_command" run ./cmd/katl-mkosi-artifacts publish-flavour "$(realpath "$output")")
    (cd "$repo_root" && "$go_command" run ./cmd/katl-mkosi-artifacts release-components "$(realpath "$output")" "${KATL_FLAVOUR:-standard}")
    write_checksums "$output"
}

# A release katlctl must be built from a clean checkout of the revision being
# released, so its embedded VCS stamp identifies exactly the source it came from.
verify_katlctl() {
    local version="$1"
    local revision target info

    validate_version "$version"
    revision="$(git -C "$repo_root" rev-parse HEAD)"
    for target in linux-amd64 darwin-arm64; do
        info="$("$go_command" version -m "$build_dir/katlctl-${version}-${target}")"
        grep -qxP '\tbuild\tvcs\.modified=false' <<<"$info" ||
            fail "katlctl-${version}-${target} was built from a modified tree; remove generated files from the checkout"
        grep -qxF "$(printf '\tbuild\tvcs.revision=%s' "$revision")" <<<"$info" ||
            fail "katlctl-${version}-${target} was not built from revision $revision"
    done
}

case "${1:-}" in
    version)
        [[ $# -ge 2 && $# -le 3 ]] || usage
        release_version "$2" "${3:-}"
        ;;
    upgrade-baseline)
        [[ $# -eq 1 ]] || usage
        production_upgrade_baseline ""
        ;;
    dev-version)
        [[ $# -eq 2 ]] || usage
        dev_version_above "$2"
        ;;
    notes)
        [[ $# -eq 2 ]] || usage
        generate_release_notes "$2"
        ;;
    count-release-notes)
        [[ $# -eq 1 ]] || usage
        count_release_notes
        ;;
    build-katlctl)
        [[ $# -eq 2 ]] || usage
        build_katlctl "$2"
        ;;
    verify-katlctl)
        [[ $# -eq 2 ]] || usage
        verify_katlctl "$2"
        ;;
    stage)
        [[ $# -eq 3 ]] || usage
        stage_artifacts "$2" "$3"
        ;;
    combine)
        [[ $# -ge 3 ]] || usage
        combine_flavours "${@:2}"
        ;;
    *)
        usage
        ;;
esac
