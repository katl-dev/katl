#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'usage: scripts/codex-role <delivery|reviewer|debugger> [--effort LEVEL] [--log PATH] [--] <task-name> <task-text-or-@file>\n' >&2
    exit 2
}

case "${1-}" in
    delivery) model=gpt-6.2-sol effort=medium sandbox=workspace-write ;;
    reviewer) model=gpt-6.2-astra effort=medium sandbox=read-only ;;
    debugger) model=gpt-6.2-astra effort=high sandbox=read-only ;;
    *) usage ;;
esac
role="$1"
shift

log=""
while [[ "${1-}" == --effort || "${1-}" == --log ]]; do
    [[ -n "${2-}" && "$2" != -* ]] || usage
    case "$1" in
        --effort) effort="$2" ;;
        --log) log="$2" ;;
    esac
    shift 2
done
if [[ "${1-}" == -- ]]; then
    shift
fi
[[ $# -eq 2 ]] || usage

task_name="$1"
unit_stem="katl-codex-$role-"
unit_suffix=.service
max_task_length=$((255 - ${#unit_stem} - ${#unit_suffix}))
unit="$unit_stem$task_name$unit_suffix"
shopt -s globasciiranges
if [[ -z "$task_name" || "$task_name" == *[!A-Za-z0-9:_.-]* || ${#task_name} -gt $max_task_length ]]; then
    printf 'codex-role: invalid task name %q. Use 1 to %s characters from [A-Za-z0-9:_.-].\n' \
        "$task_name" "$max_task_length" >&2
    exit 2
fi

task="$2"
if [[ "$task" == @* ]]; then
    file="${task#@}"
    if [[ ! -f "$file" || ! -r "$file" ]]; then
        printf 'codex-role: cannot read task file %s\n' "$file" >&2
        exit 2
    fi
    task="$(cat -- "$file")"
fi
if [[ "$task" != *[![:space:]]* ]]; then
    printf 'codex-role: task must contain text\n' >&2
    exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
guide="$repo_root/docs/development/agent-roles.md"
if ! section="$(awk -v heading="## ${role^}" '
    $0 == heading { found = 1; print; next }
    found && /^## / { exit }
    found { print }
    END { if (!found) exit 1 }
' "$guide")"; then
    printf 'codex-role: cannot find the %s role in %s\n' "$role" "$guide" >&2
    exit 1
fi

printf -v prompt '%s\n\n%s' "$section" "$task"
if systemctl --user is-active --quiet "$unit"; then
    printf 'codex-role: %s is already active. Choose another task name or wait for it to finish.\n' "$unit" >&2
    exit 1
fi

if [[ -z "$log" ]]; then
    log="$repo_root/_build/codex/${unit%.service}.log"
    mkdir -p -- "${log%/*}"
elif [[ "$log" != /* ]]; then
    log="$PWD/$log"
fi
printf 'Codex log: %s\n' "$log"

environment=(--setenv=PATH --setenv=HOME)
while IFS= read -r name; do
    case "$name" in
        CODEX_*|XDG_*) environment+=("--setenv=$name") ;;
    esac
done < <(compgen -e)

# Open the log in the service so a rejected launch cannot truncate it.
exec systemd-run --user --unit "$unit" --collect --wait --same-dir --expand-environment=no \
    "${environment[@]}" -- "$BASH" -c '
        exec >"$1" 2>&1 || exit
        shift
        status=0
        # Codex appends piped input to the prompt, so give it immediate EOF.
        codex "$@" </dev/null || status=$?
        printf "\nexit=%s\n" "$status" || exit
        exit "$status"
    ' codex-role "$log" exec -C "$repo_root" -s "$sandbox" -m "$model" -c "model_reasoning_effort=$effort" "$prompt"
