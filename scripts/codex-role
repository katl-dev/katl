#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'usage: scripts/codex-role <delivery|reviewer|debugger> [--effort LEVEL] [--log PATH] [--] <task-name> <task-text-or-@file>\n' >&2
    exit 2
}

case "${1-}" in
    delivery) model=gpt-6.2-sol effort=medium sandbox=workspace-write ;;
    reviewer) model=gpt-6.2-astra effort=medium sandbox=read-only ;;
    debugger) model=gpt-6.2-astra effort=high sandbox=read-only ;;
    *) usage ;;
esac
role="$1"
shift

log=""
while [[ "${1-}" == --effort || "${1-}" == --log ]]; do
    [[ -n "${2-}" && "$2" != -* ]] || usage
    case "$1" in
        --effort) effort="$2" ;;
        --log) log="$2" ;;
    esac
    shift 2
done
if [[ "${1-}" == -- ]]; then
    shift
fi
[[ $# -eq 2 ]] || usage

task_name="$1"
unit_stem="katl-codex-$role-"
unit_suffix=.service
max_task_length=$((255 - ${#unit_stem} - ${#unit_suffix}))
unit="$unit_stem$task_name$unit_suffix"
shopt -s globasciiranges
if [[ -z "$task_name" || "$task_name" == *[!A-Za-z0-9:_.-]* || ${#task_name} -gt $max_task_length ]]; then
    printf 'codex-role: invalid task name %q. Use 1 to %s characters from [A-Za-z0-9:_.-].\n' \
        "$task_name" "$max_task_length" >&2
    exit 2
fi

task="$2"
if [[ "$task" == @* ]]; then
    file="${task#@}"
    if [[ ! -f "$file" || ! -r "$file" ]]; then
        printf 'codex-role: cannot read task file %s\n' "$file" >&2
        exit 2
    fi
    task="$(cat -- "$file")"
fi
if [[ "$task" != *[![:space:]]* ]]; then
    printf 'codex-role: task must contain text\n' >&2
    exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
guide="$repo_root/docs/development/agent-roles.md"
if ! section="$(awk -v heading="## ${role^}" '
    $0 == heading { found = 1; print; next }
    found && /^## / { exit }
    found { print }
    END { if (!found) exit 1 }
' "$guide")"; then
    printf 'codex-role: cannot find the %s role in %s\n' "$role" "$guide" >&2
    exit 1
fi

printf -v prompt '%s\n\n%s' "$section" "$task"
if systemctl --user is-active --quiet "$unit"; then
    printf 'codex-role: %s is already active. Choose another task name or wait for it to finish.\n' "$unit" >&2
    exit 1
fi

if [[ -z "$log" ]]; then
    log="$repo_root/_build/codex/${unit%.service}.log"
    mkdir -p -- "${log%/*}"
elif [[ "$log" != /* ]]; then
    log="$PWD/$log"
fi
printf 'Codex log: %s\n' "$log"

home="$(realpath -e -- "${HOME:?HOME must be set}")"
if [[ ! -d "$home" || "$home" == / ]]; then
    printf 'codex-role: HOME must name an existing directory other than /\n' >&2
    exit 1
fi

systemd_path() {
    local path="${1//\\/\\\\}"
    printf '"%s"' "${path//\"/\\\"}"
}

# An explicit tmpfs also covers nonstandard home paths and makes systemd
# require a mount namespace when every bind maps to its original location.
mounts=(-p ProtectHome=tmpfs -p PrivateUsers=yes -p "TemporaryFileSystem=$(systemd_path "$home"):ro")
bind_dir() {
    local property="$1" dir="$2" source spec
    source="$(realpath -e -- "$dir")" && [[ -d "$source" ]] || {
        printf 'codex-role: bind directory does not exist: %s\n' "$dir" >&2
        exit 1
    }
    if [[ "$home" == "$source" || "$home" == "${source%/}/"* ]]; then
        printf 'codex-role: bind would expose all of HOME: %s\n' "$dir" >&2
        exit 1
    fi
    spec="$(systemd_path "$source")"
    if [[ "$source" != "$dir" ]]; then
        spec+=":$(systemd_path "$dir")"
    fi
    mounts+=(-p "$property=$spec")
}

bind_dir BindPaths "$repo_root"
git_common="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
case "$git_common" in
    "$repo_root"/*) ;;
    *) bind_dir BindPaths "$git_common" ;; # A linked worktree needs the shared Git metadata.
esac
log_dir="$(realpath -e -- "${log%/*}")"
case "$log_dir" in
    "$repo_root"|"$repo_root"/*) ;;
    *) bind_dir BindPaths "$log_dir" ;; # The unit opens the external log itself.
esac
log="$log_dir/${log##*/}"

export CODEX_HOME="$(realpath -m -- "${CODEX_HOME:-$HOME/.codex}")"
bind_dir BindPaths "$CODEX_HOME" # Codex uses this directory for auth and session state.
gh_config="$(realpath -m -- "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}")"
if [[ -d "$gh_config" ]]; then
    bind_dir BindReadOnlyPaths "$gh_config" # Roles use gh to read issues and pull requests.
    export GH_CONFIG_DIR="$gh_config"
fi

cache_paths="$(go env GOCACHE GOMODCACHE)"
mapfile -t caches <<<"$cache_paths"
bind_dir BindPaths "${caches[0]}"
bind_dir BindPaths "${caches[1]}"
export GOCACHE="${caches[0]}" GOMODCACHE="${caches[1]}"

codex_args=(exec -C "$repo_root" -s "$sandbox" -m "$model" -c "model_reasoning_effort=$effort")
if [[ "$sandbox" == workspace-write ]]; then
    # Host-configured roots can be masked by ProtectHome, where bubblewrap
    # cannot create the mount points it uses to protect .git. Grant write
    # access only to the workspace, Codex's temp roots, and the bound Go caches.
    codex_args+=(-c 'sandbox_workspace_write.writable_roots=[]' --add-dir "$GOCACHE" --add-dir "$GOMODCACHE")
fi

environment=(--setenv=PATH --setenv=HOME --setenv=GOCACHE --setenv=GOMODCACHE)
if [[ -n "${GH_CONFIG_DIR:-}" ]]; then
    environment+=(--setenv=GH_CONFIG_DIR)
fi
while IFS= read -r name; do
    case "$name" in
        CODEX_*|XDG_*) environment+=("--setenv=$name") ;;
    esac
done < <(compgen -e)

# Open the log in the service so a rejected launch cannot truncate it.
exec systemd-run --user --unit "$unit" --collect --wait --same-dir --expand-environment=no \
    "${mounts[@]}" "${environment[@]}" -- "$BASH" -c '
        exec >"$1" 2>&1 || exit
        shift
        status=0
        # Codex appends piped input to the prompt, so give it immediate EOF.
        codex "$@" </dev/null || status=$?
        printf "\nexit=%s\n" "$status" || exit
        exit "$status"
    ' codex-role "$log" "${codex_args[@]}" "$prompt"
