#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'usage: scripts/codex-role <delivery|reviewer|debugger|rebase> [--effort LEVEL] [--log PATH] [--bind DIR | --ro-bind PATH | --env NAME]... [--] <task-name> <task-text-or-@file>\n' >&2
    exit 2
}

case "${1-}" in
    delivery) model=gpt-6.2-sol effort=medium sandbox=workspace-write ;;
    reviewer) model=gpt-6.2-astra effort=medium sandbox=read-only ;;
    debugger) model=gpt-6.2-astra effort=high sandbox=read-only ;;
    rebase) model=gpt-6.1-terra effort=medium sandbox=workspace-write ;;
    *) usage ;;
esac
role="$1"
shift

log=""
binds=()
requested_env=()
while [[ "${1-}" == --effort || "${1-}" == --log || "${1-}" == --bind || "${1-}" == --ro-bind || "${1-}" == --env ]]; do
    [[ -n "${2-}" && "$2" != -* ]] || usage
    case "$1" in
        --effort) effort="$2" ;;
        --log) log="$2" ;;
        --bind) binds+=(BindPaths "$2") ;;
        --ro-bind) binds+=(BindReadOnlyPaths "$2") ;;
        --env) requested_env+=("$2") ;;
    esac
    shift 2
done
if [[ "${1-}" == -- ]]; then
    shift
fi
[[ $# -eq 2 ]] || usage

task_name="$1"
unit_stem="katl-codex-$role-"
unit_suffix=.service
max_task_length=$((255 - ${#unit_stem} - ${#unit_suffix}))
unit="$unit_stem$task_name$unit_suffix"
shopt -s globasciiranges
if [[ -z "$task_name" || "$task_name" == *[!A-Za-z0-9:_.-]* || ${#task_name} -gt $max_task_length ]]; then
    printf 'codex-role: invalid task name %q. Use 1 to %s characters from [A-Za-z0-9:_.-].\n' \
        "$task_name" "$max_task_length" >&2
    exit 2
fi

task="$2"
if [[ "$task" == @* ]]; then
    file="${task#@}"
    if [[ ! -f "$file" || ! -r "$file" ]]; then
        printf 'codex-role: cannot read task file %s\n' "$file" >&2
        exit 2
    fi
    task="$(cat -- "$file")"
fi
if [[ "$task" != *[![:space:]]* ]]; then
    printf 'codex-role: task must contain text\n' >&2
    exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
role_file="$repo_root/dev/agents/roles/$role.md"
if ! instructions="$(cat -- "$role_file")"; then
    printf 'codex-role: cannot read the %s role from %s\n' "$role" "$role_file" >&2
    exit 1
fi

printf -v prompt '%s\n\nRead dev/agents/README.md for the shared agent workflow.\n\n%s' "$instructions" "$task"
if systemctl --user is-active --quiet "$unit"; then
    printf 'codex-role: %s is already active. Choose another task name or wait for it to finish.\n' "$unit" >&2
    exit 1
fi

if [[ -z "$log" ]]; then
    log="${XDG_STATE_HOME:-$HOME/.local/state}/katl-dev/logs/${unit%.service}.log"
    mkdir -p -- "${log%/*}"
elif [[ "$log" != /* ]]; then
    log="$PWD/$log"
fi
printf 'Codex log: %s\n' "$log"

home="$(realpath -e -- "${HOME:?HOME must be set}")"
if [[ ! -d "$home" || "$home" == / ]]; then
    printf 'codex-role: HOME must name an existing directory other than /\n' >&2
    exit 1
fi

source "$repo_root/scripts/job-environment"
declare -A job_env=()
job_environment "$repo_root" "$home" "${requested_env[@]}"

systemd_path() {
    local path="${1//\\/\\\\}"
    printf '"%s"' "${path//\"/\\\"}"
}

# ProtectHome covers standard home paths. Use an explicit tmpfs for other
# values of HOME too, and restore the selected host paths with BindPaths.
mounts=(-p ProtectHome=tmpfs -p PrivateUsers=yes -p PrivateTmp=yes)
[[ "$home" == /tmp ]] || mounts+=(-p "TemporaryFileSystem=$(systemd_path "$home"):ro")
bind_path() {
    local property="$1" path="$2" source spec
    if ! source="$(realpath -e -- "$path")" ||
        ! [[ -d "$source" || ( "$property" == BindReadOnlyPaths && -f "$source" ) ]]; then
        printf 'codex-role: invalid %s path: %s\n' "$property" "$path" >&2
        exit 1
    fi
    if [[ "$home" == "$source" || "$home" == "${source%/}/"* ]]; then
        printf 'codex-role: bind would expose all of HOME: %s\n' "$path" >&2
        exit 1
    fi
    if [[ "$source" == /tmp || "$path" == /tmp ]]; then
        printf 'codex-role: bind would expose all of /tmp: %s\n' "$path" >&2
        exit 1
    fi
    spec="$(systemd_path "$source")"
    if [[ "$source" != "$path" ]]; then
        spec+=":$(systemd_path "$path")"
    fi
    mounts+=(-p "$property=$spec")
}

bind_path BindPaths "$repo_root"
git_common="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
case "$git_common" in
    "$repo_root"/*) ;;
    *) bind_path BindPaths "$git_common" ;; # A linked worktree needs the shared Git metadata.
esac
log_dir="$(realpath -e -- "${log%/*}")"
case "$log_dir" in
    "$repo_root"|"$repo_root"/*) ;;
    *) bind_path BindPaths "$log_dir" ;; # The unit opens the external log itself.
esac
log="$log_dir/${log##*/}"

job_env[CODEX_HOME]="$(realpath -m -- "${CODEX_HOME:-$HOME/.codex}")"
bind_path BindPaths "${job_env[CODEX_HOME]}" # Codex uses this directory for auth and session state.

bind_path BindPaths "${job_env[GOCACHE]}"
bind_path BindPaths "${job_env[GOMODCACHE]}"
for ((i = 0; i < ${#binds[@]}; i += 2)); do
    bind_path "${binds[i]}" "$(realpath -ms -- "${binds[i + 1]}")"
done

credentials=()
# Resolve auth before isolating the unit from the maintainer's keyring and home.
# Only ciphertext crosses D-Bus, and gh reads the resulting credential as config.
if command -v gh >/dev/null && gh_token="$(gh auth token --hostname github.com 2>/dev/null)" && [[ -n "$gh_token" ]]; then
    if ! [[ "$gh_token" =~ ^[A-Za-z0-9_-]+$ ]]; then
        printf 'codex-role: unexpected GitHub token format\n' >&2
        exit 1
    fi
    gh_credential="$(printf 'github.com:\n    oauth_token: "%s"\n' "$gh_token" |
        systemd-creds encrypt --user --name=hosts.yml - - | tr -d '\n')"
    unset gh_token
    # Mark the generated config as migrated so older gh versions can read it
    # without attempting to update the read-only credential directory.
    credentials+=(-p 'SetCredential=config.yml:version: 1' -p "SetCredentialEncrypted=hosts.yml:$gh_credential")
fi

codex_args=(exec -C "$repo_root" -s "$sandbox" -m "$model" -c "model_reasoning_effort=$effort")
if [[ "$sandbox" == workspace-write ]]; then
    # Host-configured roots can be masked by ProtectHome, where bubblewrap
    # cannot create the mount points it uses to protect .git. Grant write
    # access only to the workspace, Codex's temp roots, and the bound Go caches.
    codex_args+=(-c 'sandbox_workspace_write.writable_roots=[]' --add-dir "${job_env[GOCACHE]}" --add-dir "${job_env[GOMODCACHE]}")
fi

environment=()
for name in "${!job_env[@]}"; do
    environment+=("--setenv=$name=${job_env[$name]}")
done

# Open the log in the service so a rejected launch cannot truncate it.
exec systemd-run --user --unit "$unit" --collect --wait --working-directory="$repo_root" --expand-environment=no \
    "${mounts[@]}" "${credentials[@]}" "${environment[@]}" -- "$BASH" -p -c '
        exec >"$1" 2>&1 || exit
        shift
        # User units also receive the manager environment. Keep only the values
        # assigned by this launch before starting Codex.
        environment=()
        while [[ "$1" != -- ]]; do
            environment+=("$1=${!1}")
            shift
        done
        shift
        if [[ -n "${CREDENTIALS_DIRECTORY-}" ]]; then
            environment+=("GH_CONFIG_DIR=$CREDENTIALS_DIRECTORY")
        fi
        status=0
        # Codex appends piped input to the prompt, so give it immediate EOF.
        env -i "${environment[@]}" codex "$@" </dev/null || status=$?
        printf "\nexit=%s\n" "$status" || exit
        exit "$status"
    ' codex-role "$log" "${!job_env[@]}" -- "${codex_args[@]}" "$prompt"
