#!/usr/bin/env bash
set -euo pipefail

repo="${SRCDIR:-}"
builddir="${BUILDDIR:-/tmp}"
buildroot="${BUILDROOT:-}"
version="${KATL_VERSION:-0.0.0-dev}"

if [[ ! -f "$repo/go.mod" && -f /work/go.mod ]]; then
    repo=/work
fi
if [[ ! -f "$repo/go.mod" ]]; then
    echo "error: could not find repository root for endpoint advertiser build" >&2
    exit 1
fi

mkdir -p \
    "$DESTDIR/usr/lib/katl/endpoint-advertiser" \
    "$DESTDIR/usr/lib/katl/endpoint-routing" \
    "$DESTDIR/usr/lib/systemd/system"

cd "$repo"
CGO_ENABLED=0 \
GOOS=linux \
GOARCH=amd64 \
GOCACHE="$builddir/go-build" \
GOMODCACHE="${KATL_GOMODCACHE:-$repo/_build/go-mod}" \
go build \
    -trimpath \
    -buildvcs=false \
    -ldflags="-s -w -X main.version=$version" \
    -o "$DESTDIR/usr/lib/katl/endpoint-advertiser/katl-endpoint-advertiser" \
    ./cmd/katl-endpoint-advertiser

install -m 0644 \
    "$repo/mkosi.profiles/endpoint-advertiser-sysext/katl-app-bird.service" \
    "$repo/mkosi.profiles/endpoint-advertiser-sysext/katl-app-bgp-api-vip.path" \
    "$repo/mkosi.profiles/endpoint-advertiser-sysext/katl-app-bgp-api-vip.service" \
    "$DESTDIR/usr/lib/systemd/system/"

# Keep Katl's optional built-in routing implementation private. A generic BIRD
# system extension can then own the conventional binaries and bird.service
# without colliding with this application extension.
for executable in bird birdc; do
    for source in "$buildroot/usr/bin/$executable" "$buildroot/usr/sbin/$executable"; do
        if [[ -x "$source" ]]; then
            install -m 0755 "$source" "$DESTDIR/usr/lib/katl/endpoint-routing/$executable"
            break
        fi
    done
    if [[ ! -x "$DESTDIR/usr/lib/katl/endpoint-routing/$executable" ]]; then
        echo "error: Fedora bird package did not provide $executable" >&2
        exit 1
    fi
done
