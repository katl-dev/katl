[Unit]
Description=Run Katl installer entrypoint
DefaultDependencies=no
Wants=katl-input-apply.service systemd-modules-load.service systemd-networkd.service systemd-resolved.service network-online.target
After=katl-input-apply.service systemd-modules-load.service systemd-networkd.service systemd-resolved.service network-online.target
Before=initrd.target

[Service]
Type=oneshot
NotifyAccess=main
TimeoutStartSec=infinity
ExecStart=/usr/bin/katlos-install --boot
StandardOutput=journal+console
StandardError=journal+console
