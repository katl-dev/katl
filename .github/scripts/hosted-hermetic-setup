#!/usr/bin/env bash
set -euo pipefail

probe() {
    "$1" --unshare-user --dev-bind / / -- "$1" --unshare-user --dev-bind / / -- true
}

bwrap="$(realpath -- "$(command -v bwrap)")"
if output="$(probe "$bwrap" 2>&1)"; then
    printf 'hosted-hermetic-setup: %s runs nested user namespaces\n' "$bwrap"
    exit 0
fi
restriction=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
if [[ "${RUNNER_ENVIRONMENT:-}" != github-hosted || ! -r "$restriction" || "$(<"$restriction")" != 1 ]]; then
    printf 'Bubblewrap needs nested user namespaces on the test runner:\n%s\n' "$output" >&2
    exit 1
fi

# An ephemeral Ubuntu runner can grant user namespaces to the ci shell's
# Bubblewrap without changing the system restriction or the distro profile.
# A Nix store path is immutable and no distro profile names it, so it is
# profiled in place, and every later step in the shell resolves the same path.
if [[ "$bwrap" != /nix/store/* ]]; then
    printf 'hosted-hermetic-setup: %s is not the ci shell'\''s Bubblewrap; run this through .github/scripts/ci-shell\n' "$bwrap" >&2
    exit 1
fi
sudo apparmor_parser -r <<EOF
abi <abi/4.0>,
profile katl-ci-bwrap $bwrap flags=(unconfined) {
  userns,
}
EOF
probe "$bwrap"
printf 'hosted-hermetic-setup: granted nested user namespaces to %s\n' "$bwrap"
