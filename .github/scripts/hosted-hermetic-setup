#!/usr/bin/env bash
set -euo pipefail

probe() {
    "$1" --unshare-user --dev-bind / / -- "$1" --unshare-user --dev-bind / / -- true
}

bwrap="$(realpath -- "$(command -v bwrap)")"
if output="$(probe "$bwrap" 2>&1)"; then
    exit 0
fi
restriction=/proc/sys/kernel/apparmor_restrict_unprivileged_userns
if [[ "${RUNNER_ENVIRONMENT:-}" != github-hosted || ! -r "$restriction" || "$(<"$restriction")" != 1 ]]; then
    printf 'Bubblewrap needs nested user namespaces on the test runner:\n%s\n' "$output" >&2
    exit 1
fi

# An ephemeral Ubuntu runner can grant user namespaces to its CI copy of
# Bubblewrap without changing the system restriction or the distro profile.
# A Nix store path is immutable and no distro profile names it, so the ci
# shell's Bubblewrap is profiled in place: every later step in the shell
# resolves the same path ahead of anything on GITHUB_PATH.
if [[ "$bwrap" == /nix/store/* ]]; then
    ci_bwrap=$bwrap
else
    ci_bin=/opt/katl-ci/bin
    ci_bwrap=$ci_bin/bwrap
    sudo install -D -m 0755 -- "$bwrap" "$ci_bwrap"
fi
sudo apparmor_parser -r <<EOF
abi <abi/4.0>,
profile katl-ci-bwrap $ci_bwrap flags=(unconfined) {
  userns,
}
EOF
probe "$ci_bwrap"
if [[ -n "${ci_bin:-}" ]]; then
    printf '%s\n' "$ci_bin" >>"$GITHUB_PATH"
fi
