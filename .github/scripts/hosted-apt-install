#!/usr/bin/env bash
set -euo pipefail

[[ $# -gt 0 ]] || { echo 'usage: hosted-apt-install PACKAGE...' >&2; exit 2; }

ubuntu_sources=/etc/apt/sources.list.d/ubuntu.sources
if [[ -f "$ubuntu_sources" ]]; then
    sudo sed -i -E 's@https?://azure\.archive\.ubuntu\.com/ubuntu@https://archive.ubuntu.com/ubuntu@g' "$ubuntu_sources"
fi

# Keep the upstream HTTPS fallbacks when APT uses a mirror list.
if [[ -f /etc/apt/apt-mirrors.txt ]]; then
    sudo sed -i '/azure\.archive\.ubuntu\.com/d' /etc/apt/apt-mirrors.txt
fi

apt_options=(-o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30)
sudo apt-get "${apt_options[@]}" update -qq
sudo apt-get "${apt_options[@]}" install -y --no-install-recommends "$@"
