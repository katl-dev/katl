#!/usr/bin/env bash
set -euo pipefail

# Refresh supplementary groups without changing the login GID: rootless Podman
# rejects newuidmap when the process's primary GID differs from the passwd entry.
exec sudo --preserve-env --user="$(id -un)" env PATH="$PATH" bash -c '
    id
    exec scripts/vmtest-run "$@"
' -- "$@"
