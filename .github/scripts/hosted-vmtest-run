#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" == 0 ]]; then
    exec scripts/vmtest-run "$@"
fi

# Refresh supplementary groups for libvirt and device access after provisioning.
exec sudo --preserve-env --user="$(id -un)" env PATH="$PATH" bash -c '
    id
    exec scripts/vmtest-run "$@"
' -- "$@"
