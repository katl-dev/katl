#!/usr/bin/env bash
set -euo pipefail

if [[ "$(id -u)" == 0 ]]; then
    exec scripts/vmtest-run "$@"
fi

# Pick up KVM group membership granted while preparing the hosted runner.
exec sudo --preserve-env --user="$(id -un)" env PATH="$PATH" bash -c '
    id
    exec scripts/vmtest-run "$@"
' -- "$@"
