#!/usr/bin/env bash
# Downloads a large workflow input with a bounded attempt and jittered
# exponential backoff, so one stalled transfer cannot consume a job's budget.
#
#   hosted-download artifact NAME DEST [RUN_ID]
#   hosted-download release TAG DEST
#
# scripts/retry runs every attempt under KATL_DOWNLOAD_ATTEMPT_SECONDS
# (default 360) and makes KATL_DOWNLOAD_ATTEMPTS (default 3) attempts,
# sleeping between them for a random time in [b, 2b) where b doubles from
# KATL_DOWNLOAD_BACKOFF_SECONDS (default 15). With the defaults the worst case
# is 3 * 360 s + (15..30 s) + (30..60 s) < 19.5 minutes, which is why callers
# give the step 20 minutes.
set -euo pipefail

usage() {
    echo 'usage: hosted-download artifact NAME DEST [RUN_ID] | release TAG DEST' >&2
    exit 2
}

fail() {
    echo "::error title=Download failed::hosted-download: $what: $*" >&2
    exit 1
}

# One attempt, run by scripts/retry under its time limit. It writes into its
# own staging directory and moves only a complete download to DEST, so a
# partial or interrupted transfer never reaches the caller. staging is global
# so the EXIT trap still sees it after the function returns.
attempt() {
    local dest="$1"
    shift
    staging=$(mktemp -d "$dest.attempt-XXXXXX")
    trap 'rm -rf -- "$staging"' EXIT
    trap 'exit 143' TERM
    "$@" --dir "$staging"
    mv -T -- "$staging" "$dest"
    trap - EXIT
}

if [[ "${1:-}" == --attempt ]]; then
    shift
    attempt "$@"
    exit 0
fi

[[ $# -ge 3 ]] || usage
kind=$1 subject=$2 dest=$3
case "$kind" in
    artifact)
        [[ $# -le 4 ]] || usage
        run_id=${4:-${GITHUB_RUN_ID:?}}
        what="artifact $subject from run $run_id"
        ;;
    release)
        [[ $# -eq 3 ]] || usage
        what="release $subject"
        ;;
    *) usage ;;
esac

repo=${GITHUB_REPOSITORY:?}
command -v gh >/dev/null || fail 'gh is not installed on this runner'

mkdir -p "$(dirname -- "$dest")"
[[ ! -e "$dest" ]] || fail "destination $dest already exists"

if [[ "$kind" == artifact ]]; then
    command=(gh run download "$run_id" --repo "$repo" --name "$subject")
else
    command=(gh release download "$subject" --repo "$repo")
fi
"$(dirname -- "${BASH_SOURCE[0]}")/../../scripts/retry" \
    --attempts "${KATL_DOWNLOAD_ATTEMPTS:-3}" \
    --timeout "${KATL_DOWNLOAD_ATTEMPT_SECONDS:-360}" \
    --backoff "${KATL_DOWNLOAD_BACKOFF_SECONDS:-15}" \
    --title 'Download retry' --what "hosted-download: $what" \
    -- "${BASH_SOURCE[0]}" --attempt "$dest" "${command[@]}" ||
    fail "giving up after ${KATL_DOWNLOAD_ATTEMPTS:-3} attempts"
