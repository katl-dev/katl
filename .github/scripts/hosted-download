#!/usr/bin/env bash
# Downloads a large workflow input with a bounded attempt and jittered
# exponential backoff, so one stalled transfer cannot consume a job's budget.
#
#   hosted-download artifact NAME DEST [RUN_ID]
#   hosted-download release TAG DEST
#
# Every attempt runs under KATL_DOWNLOAD_ATTEMPT_SECONDS (default 360) and the
# owner makes KATL_DOWNLOAD_ATTEMPTS (default 3) attempts, sleeping between
# them for a random time in [b, 2b) where b doubles from
# KATL_DOWNLOAD_BACKOFF_SECONDS (default 15). With the defaults the worst case
# is 3 * 360 s + (15..30 s) + (30..60 s) < 19.5 minutes, which is why callers
# give the step 20 minutes.
set -euo pipefail

usage() {
    echo 'usage: hosted-download artifact NAME DEST [RUN_ID] | release TAG DEST' >&2
    exit 2
}

[[ $# -ge 3 ]] || usage
kind=$1 subject=$2 dest=$3
case "$kind" in
    artifact)
        [[ $# -le 4 ]] || usage
        run_id=${4:-${GITHUB_RUN_ID:?}}
        what="artifact $subject from run $run_id"
        ;;
    release)
        [[ $# -eq 3 ]] || usage
        what="release $subject"
        ;;
    *) usage ;;
esac

attempts=${KATL_DOWNLOAD_ATTEMPTS:-3}
attempt_seconds=${KATL_DOWNLOAD_ATTEMPT_SECONDS:-360}
backoff=${KATL_DOWNLOAD_BACKOFF_SECONDS:-15}
repo=${GITHUB_REPOSITORY:?}

fail() {
    echo "::error title=Download failed::hosted-download: $what: $*" >&2
    exit 1
}

command -v gh >/dev/null || fail 'gh is not installed on this runner'

# Each attempt writes into its own staging directory and only a complete
# attempt is moved to DEST, so a partial transfer never reaches the caller.
mkdir -p "$(dirname -- "$dest")"
[[ ! -e "$dest" ]] || fail "destination $dest already exists"

for ((attempt = 1; ; attempt++)); do
    staging=$(mktemp -d "$dest.attempt-XXXXXX")
    if [[ "$kind" == artifact ]]; then
        command=(gh run download "$run_id" --repo "$repo" --name "$subject" --dir "$staging")
    else
        command=(gh release download "$subject" --repo "$repo" --dir "$staging")
    fi

    echo "hosted-download: $what, attempt $attempt/$attempts (limit ${attempt_seconds}s)" >&2
    started=$SECONDS
    status=0
    timeout --kill-after=30s "${attempt_seconds}s" "${command[@]}" || status=$?
    if [[ $status == 0 ]]; then
        mv -T -- "$staging" "$dest"
        echo "hosted-download: $what finished in $((SECONDS - started))s" >&2
        exit 0
    fi
    rm -rf -- "$staging"

    if [[ $status == 124 || $status == 137 ]]; then
        reason="timed out after ${attempt_seconds}s"
    else
        reason="exited $status after $((SECONDS - started))s"
    fi
    if ((attempt >= attempts)); then
        fail "attempt $attempt/$attempts $reason; giving up"
    fi
    delay=$((backoff + RANDOM % (backoff > 0 ? backoff : 1)))
    echo "::warning title=Download retry::hosted-download: $what: attempt $attempt/$attempts $reason; retrying in ${delay}s" >&2
    sleep "$delay"
    backoff=$((backoff * 2))
done
